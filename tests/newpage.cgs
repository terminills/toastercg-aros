# a page from nothing, as the shipped ARexx scripts would build one
LOADFONT "Toaster:PSFonts/B&PGraphics/Olnova-DemiBold" 40
EXPECT 1
LOADFONT "Toaster:PSFonts/SoftMaker/Benjamin-Book" 30
EXPECT 1
SET_PAGE 5
GET_PAGE
EXPECT 5
SET_PAGE TYPE FRAME
GET_PAGE TYPE
EXPECT Framestore
SET_BACK TOPR 0 0 80
SET_BACK BOTR 0 0 20
SET_BACK TYPE 1
SET_FONT "Toaster:PSFonts/B&PGraphics/Olnova-DemiBold" 40
SET_CHAR RGBA 240 200 60 255
SET_SHAD TYPE CAST
SET_SHAD SIZE 3
SET_BORD SIZE 2
MAKE_LINE "ToasterCG on AROS"
GET_PAGE SIZE
EXPECT 2
SET_LINE FIRS
GET_LINE
EXPECT ToasterCG on AROS
SET_LINE JUST C
GET_LINE JUST
EXPECT Center
SET_LINE NEXT
SET_FONT "Toaster:PSFonts/SoftMaker/Benjamin-Book" 30
SET_CHAR RGBA 255 255 255 255
SET_SHAD TYPE DROP
SET_BORD SIZE 0
MAKE_CHAR A
MAKE_CHAR B
MAKE_CHAR C
GET_LINE
EXPECT ABC
GET_CHAR SPOT
EXPECT 3
PICK_LINE
SET_CHAR FILL 1
SET_CHAR BOTR 255 80 0 255
GET_CHAR FILL
EXPECT 1
MAKE_RECT 60 300 632 120
GET_LINE TYPE
EXPECT Box
GET_RECT SIZE
EXPECT 632 120
RENDER build/test/newpage.png
SAVE build/test/newpage.book
SAVEPAGE build/test/newpage.frame
